<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (fullBackupContent). Same intent as backup_rules.xml: keep the live-session
  and shield-token stores off cloud backup so they can't be restored stale onto another device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session_preferences.preferences_pb" />
    <exclude domain="file" path="datastore/shield_preferences.preferences_pb" />
</full-backup-content>
